// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// User Model Example
enum Role {
  admin
  sales_engineer_1
  sales_engineer_2
  sales_engineer_lead
  /// Customer success: sees their self-serve clients and Lone Wolves, read-only.
  csm
  /// Customer success lead: everything a CSM sees, and edits Lone Wolves.
  csm_lead
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  firstName           String?
  lastName            String?
  isActive            Boolean   @default(true)
  // When true, the next successful login will force the user through the
  // /change-password flow before any other route renders. Set by the admin
  // reset-password action so we can issue a random temporary credential
  // (instead of relying on string-matching the literal "password") and
  // still guarantee the user picks a new one immediately.
  mustChangePassword  Boolean   @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  salesEngineer     SalesEngineer?
  userRoles         UserRole[]
  googleIntegration UserGoogleIntegration?
  maintenanceClaims MaintenanceClaim[]

  @@map("users")
}

/// Per-user Google Calendar OAuth tokens (refresh/access ciphertext only at rest).
model UserGoogleIntegration {
  id                   String    @id @default(cuid())
  userId               String    @unique
  googleSub            String?
  refreshTokenEnc      String
  accessTokenEnc       String?
  accessTokenExpiresAt DateTime?
  scopes               String?
  connectedAt          DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_google_integrations")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
  @@map("user_roles")
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  salesEngineer     SalesEngineer?    // One team = one SE
  accountExecutives AccountExecutive[]

  @@map("teams")
}

model SalesEngineer {
  id             String   @id @default(cuid())
  userId         String   @unique
  teamId         String   @unique
  salesforceEmail String?
  salesforceId   String?
  linearUserId   String?  @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  team            Team             @relation(fields: [teamId], references: [id])
  teamAssignments TeamAssignment[]
  opps            Opp[]
  carrAttributions OppCarrAttribution[]

  @@index([userId])
  @@index([teamId])
  @@map("sales_engineers")
}

model AccountExecutive {
  id            String   @id @default(cuid())
  name          String
  salesforceId  String   @unique
  salesforceEmail String?
  teamId        String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  team            Team             @relation(fields: [teamId], references: [id])
  teamAssignments TeamAssignment[]

  @@index([teamId])
  @@index([salesforceId])
  @@map("account_executives")
}

model TeamAssignment {
  id                 String   @id @default(cuid())
  salesEngineerId    String
  accountExecutiveId String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  salesEngineer    SalesEngineer    @relation(fields: [salesEngineerId], references: [id], onDelete: Cascade)
  accountExecutive AccountExecutive @relation(fields: [accountExecutiveId], references: [id], onDelete: Cascade)

  @@unique([salesEngineerId, accountExecutiveId])
  @@index([salesEngineerId])
  @@index([accountExecutiveId])
  @@map("team_assignments")
}

/// Per-opportunity handoff page owned by a single SE. SE-authored content
/// (technical specs, notes, custom sections, people snapshots) lives here;
/// SF / Gong / Linear data is fetched live at read time and never persisted.
model Opp {
  id                      String   @id @default(cuid())
  salesEngineerId         String
  oppName                 String
  salesforceOpportunityId String?

  // People snapshots (plain strings -- CSMs / QA Leads typically aren't app users).
  aeNameOverride String?
  csmName        String?
  qaLeadName     String?
  qaManagerName  String?

  // SE-authored content. JSON blobs keep the schema flat and 1:1 with a
  // future Notion page sync (one row -> one page).
  technicalSpecsJson String?
  // QAE team assignment (Alpacas / Badgers / etc.). Surfaces in the
  // Hunt Board handoff page and gets written to the Notion DB's
  // "QAE Team" select column on send.
  qawTeam            String?
  // SF stage snapshot. Refreshed by the FE whenever the detail page
  // hydrates Salesforce data so the Hunt Board directory can render a
  // stage pill without N synchronous SF queries on every list load.
  // Stale-by-design between visits -- the SF card on the detail page is
  // the authoritative source.
  currentStage       String?
  stageSyncedAt      DateTime?
  notesMarkdown      String?
  customSectionsJson String?

  // Manually-linked Linear tickets -- JSON array of
  //   { identifier: "AXO-959", addedAt, addedByUserId }
  // for cases where the AE didn't follow naming conventions and the
  // auto-discovery query in findLinearTicketsForOpp won't catch the ticket.
  // These are resolved against Linear at read time so we never store stale
  // ticket state in our DB.
  manualLinearLinksJson String?

  // Test creation handoff details -- demo workspace + the list of flows
  // the AE built. Shape:
  //   { demoWorkspaceUrl: string, flows: [{ id, name, url }] }
  creationJson String?

  // Estimation handoff details -- type (ratio vs exploratory) plus the
  // type-specific artifacts and the shared spreadsheet URL. Shape:
  //   { type: 'ratio' | 'exploratory' | null,
  //     ratioDocUrl, exploratoryNotes, spreadsheetUrl }
  estimationJson String?

  // Notion handoff page. Populated the first time an SE clicks
  // "Send to Notion" on the Hunt Board page; afterwards the FE shows
  // "Open in Notion" using the cached URL. A re-sync overwrites these
  // with a fresh page (old page stays in Notion -- SE can archive there).
  notionPageId   String?
  notionPageUrl  String?
  notionSyncedAt DateTime?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  salesEngineer SalesEngineer @relation(fields: [salesEngineerId], references: [id], onDelete: Cascade)

  @@unique([salesEngineerId, oppName])
  @@index([salesEngineerId])
  @@map("opps")
}

model QuarterlyGoal {
  id String @id @default(cuid())
  year Int
  quarter Int
  goal Float

  @@unique([year, quarter])
  @@index([year])
  @@map("quarterly_goals")
}


/// Manual SE credit for a historical closed-won opportunity.
///
/// The "All Closed Won" Salesforce report stays the source of truth for the
/// opportunity itself (name, fiscal period, CARR, owner); this table records
/// only *which SE gets credit*, keyed by the Salesforce Opportunity Id so a
/// renamed opp keeps its attribution. There is no "None" row -- clearing a
/// picker deletes the row, so unattributed CARR is simply absent and can
/// never be double-counted into a total.
model OppCarrAttribution {
  id                      String   @id @default(cuid())
  salesforceOpportunityId String   @unique
  salesEngineerId         String
  /// Report label at the time of assignment, for reading this table directly.
  /// Never used for totals -- the live report always wins on name and amount.
  oppName                 String?
  assignedByUserId        String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  salesEngineer SalesEngineer @relation(fields: [salesEngineerId], references: [id], onDelete: Cascade)

  @@index([salesEngineerId])
  @@map("opp_carr_attributions")
}


/// An SE's claim on a Bone Pile customer: "I'm on this one", so the rest of
/// the team can see it is taken. Keyed by the QA Wolf workspace id, which is
/// how the snapshot keys customers. The snapshot lives only in memory, so
/// claims are kept here, where they outlive a restart or a deploy. Each SE
/// holds at most one claim per customer, and several SEs may each hold one on
/// the same customer. A claim counts until `expiresAt`; renewing moves it on by
/// MAINTENANCE_DASHBOARD_CLAIM_DAYS. Reads skip lapsed claims and every write
/// deletes them, so nothing runs on a schedule, and a claim made after one
/// lapsed is a new row: `createdAt` is when it was claimed. Releasing deletes
/// the row.
model MaintenanceClaim {
  id            String   @id @default(cuid())
  workspaceId   String
  /// The customer's name when it was claimed or last renewed, for reading this
  /// table directly and for naming a claim whose customer has left the
  /// snapshot. Never used for matching -- the workspace id is the key.
  workspaceName String?
  userId        String
  /// One line of plain text, at most 140 characters. claimShape.js enforces
  /// it, so neither schema needs a native column type.
  note          String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("maintenance_claims")
}

/// One workspace on the Lone Wolves (self-serve onboarding) page, and what
/// the platform cannot say about it: when it kicked off, how long its pilot
/// runs, who owns failures, and the onboarding ticket. Workspaces on Task
/// Wolf's SelfService QA team are listed without a row; a row is written the
/// first time someone records a detail, or when a workspace from another team
/// (a pilot, a self-managed workspace in a full-service account) is added by
/// hand. Nothing here is copied from QA Wolf, so a rescan never overwrites it.
model OnboardingWorkspace {
  id                  String    @id @default(cuid())
  workspaceId         String    @unique
  /// The workspace's name when the row was last saved, for reading this table.
  workspaceName       String?
  /// The environment the page counts (flows, runs, triggers, bugs); null
  /// means the workspace's default. Picked by hand where a workspace keeps
  /// a pilot's environment beside others, e.g. Panorama's Self-Serve.
  environmentId       String?
  /// self | custom | pilot | hybrid; null shows as self-serve.
  segment             String?
  /// Added by hand rather than found on the SelfService QA team.
  addedManually       Boolean   @default(false)
  /// Taken off the page without deleting what was recorded.
  hidden              Boolean   @default(false)
  kickoffOn           DateTime?
  pilotDays           Int?
  linearIssue         String?
  ae                  String?
  csm                 String?
  /// The customer's named owner for reviewing failures; set means step done.
  failureOwner        String?
  /// Whether the client has started building tests themselves; null is unknown.
  clientBuildingTests Boolean?
  nextStep            String?
  /// Which price the page shows and the usage message carries: old
  /// (per-minute), new (runs-based) or none (counts only). Picked per
  /// workspace by its CSM; null reads as old, which every customer signed
  /// before 10/19 is on.
  pricing             String?
  updatedBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("onboarding_workspaces")
}

/// One finished Monday-to-Sunday week (UTC) of a workspace environment's
/// usage, counted once from its runs' attempts and kept, since a closed week
/// no longer changes and recounting means reading every run again. The
/// current week is never stored; it is counted on each scan.
model OnboardingUsageWeek {
  id            String   @id @default(cuid())
  workspaceId   String
  environmentId String
  /// Monday 00:00 UTC.
  weekStart     DateTime
  runs          Int
  /// One per flow per run.
  flowRuns      Int
  attempts      Int
  /// Every attempt's runtime, retries included.
  runnerSeconds Float
  /// Run credits: per flow run, 1 per started 5 minutes of its longest
  /// attempt (2 on iOS, Android, Windows and Mac), at least 1.
  credits       Int
  createdAt     DateTime @default(now())

  @@unique([workspaceId, environmentId, weekStart])
  @@map("onboarding_usage_weeks")
}
